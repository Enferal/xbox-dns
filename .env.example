# Скопируйте в .env. Пароль не нужен: устройство только указывает DNS этого VPS.

# Где принимать клиентов. 0.0.0.0 — все интерфейсы.
LISTEN_IP=0.0.0.0
DNS_PORT=53

# Порты, на которых сайт открывается у клиента. Имя берётся из TLS или заголовка Host.
# Через запятую. Диапазон: 15000-15099. Для UFC 5: 80,443,42130,44326,15000-15099
PROXY_PORTS=80,443

# Куда спрашивать настоящие адреса и все домены не из списка.
DNS_UPSTREAM=1.1.1.1,8.8.8.8

# Сколько меток поддомена покрывает запись example.com.
# 4 означает a.b.c.d.example.com, но не a.b.c.d.e.example.com.
MAX_WILDCARD_DEPTH=4

# Сколько секунд клиент помнит ответ DNS.
ANSWER_TTL=60

# 1 — домены из списка получают и IPv4, и IPv6 адрес этого VPS.
IPV6=1

# Кто может обращаться к этому DNS.
# Пусто — может любой адрес.
# Несколько адресов или сетей через запятую: 203.0.113.8,198.51.100.0/24
ALLOW_CLIENTS=
