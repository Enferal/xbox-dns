# Тест Xbox. На устройстве указывается только DNS, равный адресу этого VPS.
# Сайты из списка ниже открываются через VPS, удалённая сторона видит адрес сервера.
# Остальные имена идут как обычно.
#
# Домены не в этом файле, а в config/allow-destinations.xbox.txt:
#   xboxlive.com, xbox.com, xboxservices.com, gamepass.com,
#   bing.com, microsoft.com, akamai.net, akamaized.net, live.com
#
# На сервере после установки:
#   cp /opt/egress-proxy/.env.xbox.test /etc/egress-proxy/egress.env
#   cp /opt/egress-proxy/config/allow-destinations.xbox.txt /etc/egress-proxy/allow-destinations.txt
#   systemctl restart egress-proxy
#
# В exit-ips.txt должна остаться строка auto: DNS отдаёт адрес самого VPS.

LISTEN_IP=0.0.0.0
DNS_PORT=53
PROXY_PORTS=80,443

# Настоящие адреса сайтов спрашиваются у публичных DNS, не у клиента.
DNS_UPSTREAM=1.1.1.1,8.8.8.8

# user.auth.xboxlive.com и prod.xsts.auth.xboxlive.com укладываются в 4 метки.
MAX_WILDCARD_DEPTH=4
ANSWER_TTL=60

# 1 — домены Xbox получают и IPv4, и IPv6 адрес этого VPS.
IPV6=1

# Пусто: для теста можно сразу указать DNS на телефоне или консоли, не зная их адрес.
ALLOW_CLIENTS=
