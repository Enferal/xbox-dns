# Пример для сервисов Xbox по списку доменов Microsoft Game Development Kit.
# На устройстве по-прежнему указывается только DNS этого VPS.
#
# Подключение:
#   cp .env.xbox.example .env
#   cp config/allow-destinations.xbox.txt config/allow-destinations.txt
#
# Домены лежат не здесь, а в config/allow-destinations.xbox.txt.
# Этот файл задаёт порты и глубину маски.

LISTEN_IP=0.0.0.0
DNS_PORT=53

# Microsoft указывает для связи с сервисами Xbox порт TCP 443.
# 80 оставлен для редиректов на HTTPS.
# UFC 5 дополнительно открывает TCP 42130, 44326 и диапазон blaze 15000-15099.
# PROXY_PORTS=80,443,42130,44326,15000-15099
PROXY_PORTS=80,443

DNS_UPSTREAM=1.1.1.1,8.8.8.8

# example.com + 4 метки поддомена: a.b.c.d.example.com
# Хосты Xbox из документации укладываются в эту глубину.
MAX_WILDCARD_DEPTH=4

ANSWER_TTL=60

# 1 — домены Xbox получают и IPv4, и IPv6 адрес этого VPS.
IPV6=1

# Кто может обращаться к этому DNS. Пусто — может любой адрес.
# ALLOW_CLIENTS=203.0.113.8,198.51.100.0/24
ALLOW_CLIENTS=
