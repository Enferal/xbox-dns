[Unit]
Description=Web UI для egress-proxy
After=network-online.target egress-proxy.service
Wants=network-online.target

[Service]
Type=simple
# root нужен для ufw, systemctl, записи /etc/egress-proxy и обновления кода.
User=root
Environment=PYTHONPATH=/usr/local/lib/egress-proxy
Environment=UI_ENV_FILE=/etc/egress-proxy-ui/ui.env
ExecStart=/usr/bin/python3 -u -m egress_ui
WorkingDirectory=/usr/local/lib/egress-proxy
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
StateDirectory=egress-proxy-ui
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
