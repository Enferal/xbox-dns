[Unit]
Description=DNS и прокси доменов через адреса VPS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=egress-proxy
Group=egress-proxy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/usr/bin/python3 -u /usr/local/lib/egress-proxy/egress_proxy.py
ExecStartPre=/usr/bin/python3 /usr/local/lib/egress-proxy/egress_proxy.py --check-config
Environment=EXIT_IPS_FILE=/etc/egress-proxy/exit-ips.txt
Environment=DESTINATIONS_FILE=/etc/egress-proxy/allow-destinations.txt
EnvironmentFile=-/etc/egress-proxy/egress.env
Restart=on-failure
RestartSec=2
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
